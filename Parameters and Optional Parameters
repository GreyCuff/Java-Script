<!DOCTYPE html>
<html>
<body>

    <h2>JavaScript Parameters</h2>
    <p>Calculate the total price of a product.</p>

    <p id="result"></p>

    <script>

        // 'price' is a required parameter.
        // 'quantity' is an optional parameter.
        function calculateBill(price, quantity) {

            // If quantity is not provided, use 1.
            if (quantity === undefined) {
                quantity = 1;
            }

            return price * quantity;
        }

        // Calling the function with both parameters
        var multipleItems = calculateBill(150, 3);

        // Calling the function with only the required parameter
        var singleItem = calculateBill(200);

        document.getElementById("result").innerHTML =
            "Price for 3 items: ₹" + multipleItems + "<br>" +
            "Price for 1 item: ₹" + singleItem;

    </script>

</body>
</html>
