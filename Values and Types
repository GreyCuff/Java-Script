<!DOCTYPE html>
<html>
<body>

    <h2>JavaScript Values and Data Types</h2>

    <p id="output"></p>

    <script>
        // Different values with different data types
        var studentName = "Aarav";       // String
        var age = 12;                    // Number
        var isPresent = true;            // Boolean
        var score = 87.5;                // Number

        // Display the values
        document.getElementById("output").innerHTML =
            "Student: " + studentName + "<br>" +
            "Age: " + age + "<br>" +
            "Present: " + isPresent + "<br>" +
            "Test Score: " + score;
    </script>

</body>
</html>
