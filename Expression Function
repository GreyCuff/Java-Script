<!DOCTYPE html>
<html>
<head>
    <title>Expression Function</title>
</head>

<body>

    <h2>JavaScript Function Expression</h2>
    <p>Calculate the area of a rectangle.</p>

    <p id="result"></p>

    <script>

        // Store a function inside a variable
        var findArea = function(length, width) {
            return length * width;
        };

        // Execute the function
        var area = findArea(12, 5);

        // Display the result
        document.getElementById("result").innerHTML =
            "The area of the rectangle is " + area + " square units.";

    </script>

</body>
</html>
