<!DOCTYPE html>
<html>
<body>

    <h2>JavaScript Variables</h2>
    <p>Calculating the total cost of two items.</p>

    <p id="output"></p>

    <script>
        // Store the prices in variables
        var itemPrice1 = 120;
        var itemPrice2 = 80;

        // Add the two prices
        var totalCost = itemPrice1 + itemPrice2;

        // Display the result on the webpage
        document.getElementById("output").innerHTML =
            "The total cost is ₹" + totalCost;
    </script>

</body>
</html>
