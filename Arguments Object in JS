<!DOCTYPE html>
<html>
<body>

    <h2>JavaScript Arguments Object</h2>
    <p>Calculate the total of all numbers passed to a function.</p>

    <p id="result"></p>

    <script>

        function calculateTotal() {
            var total = 0;

            // arguments contains all values passed to the function
            for (var i = 0; i < arguments.length; i++) {
                total += arguments[i];
            }

            return total;
        }

        // Pass any number of values to the function
        var answer = calculateTotal(10, 25, 15, 30);

        document.getElementById("result").innerHTML =
            "The total is: " + answer;

    </script>

</body>
</html>
